{
  // ── ตรวจภาษาโปรแกรมให้ชุดทดสอบด้วย ────────────────────────────────────────────
  //
  // เดิม `turbo typecheck` ตรวจเฉพาะสองแอป — ไฟล์ใน tests/ ไม่เคยถูกตรวจเลย
  //   Playwright คอมไพล์ไฟล์ทีละไฟล์ตอนรัน (transpile only) จึงไม่ได้ตรวจชนิดข้อมูลให้
  //   ผลคือเทสต์ที่เรียก repo/RPC ด้วยพารามิเตอร์ผิดชนิดหรือขาดไป จะเงียบจนกว่าจะรันถึงบรรทัดนั้น
  //   และเทสต์ที่อ้างฟิลด์ที่ไม่มีอยู่จริงจะได้ undefined แล้ว "ผ่าน" แบบไม่ได้ตรวจอะไร
  //   (ผลตรวจสอบระบบรอบ 2 · เครื่องมือตรวจ)
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": "..",
    "types": ["node"],
    "paths": {
      "@pms/shared/*": ["packages/shared/*"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
