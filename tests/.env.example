# บัญชีทดสอบสำหรับชุดเทสต์ที่ต้องใช้ backend จริง (supabase-smoke / supabase-rls)
# คัดลอกไฟล์นี้เป็น tests/.env.test แล้วใส่ค่าจริง — tests/.env.test ถูก .gitignore คุมไว้ (กฎ .env*)
# ไม่ตั้งค่า = ชุดเทสต์กลุ่มนี้ข้ามตัวเองพร้อมบอกเหตุผล (ไม่ทำให้ทั้งชุดพัง)
#
# URL / anon key ไม่ต้องใส่ที่นี่ — อ่านจาก apps/dealer/.env.local ซึ่งเป็นค่าที่แอปใช้จริงอยู่แล้ว
# ห้ามใส่ service_role key ที่ไหนทั้งสิ้น

# ตัวแทนระยอง
TEST_RYG_EMAIL=sales@example.co.th
TEST_RYG_PASSWORD=

# ตัวแทนเชียงใหม่ (ใช้ทดสอบว่าสาขาหนึ่งแตะข้อมูลอีกสาขาไม่ได้)
TEST_CNX_EMAIL=sales@example.co.th
TEST_CNX_PASSWORD=

# ผู้ดูแลสำนักงานใหญ่
TEST_ADMIN_EMAIL=admin@example.com
TEST_ADMIN_PASSWORD=
