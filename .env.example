# Benjamin PMS — ตัวแปรสภาพแวดล้อม (คัดลอกเป็น .env.local ในแต่ละแอป: apps/dealer, apps/hq)

# แหล่งข้อมูล: local (mock/localStorage) | supabase (backend จริง)
NEXT_PUBLIC_DATA_SOURCE=supabase 

# Supabase — ใช้เมื่อ NEXT_PUBLIC_DATA_SOURCE=supabase (ดู BACKEND-DESIGN.md)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── เฉพาะแอป HQ (apps/hq/.env.local) — งาน admin ที่ต้องทำฝั่งเซิร์ฟเวอร์ ────────────
# service_role key: ใช้สร้างบัญชีตัวแทน (H5) ที่ Route Handler /api/admin/dealers
#
# ⚠️ ความปลอดภัย — คีย์นี้ข้าม RLS ได้ทั้งระบบ:
#   • "ห้าม" ใส่คำนำหน้า NEXT_PUBLIC_ (จะถูกฝังลงบันเดิลที่เบราว์เซอร์เห็น)
#   • "ห้าม" commit ค่าจริงลง git · ใส่เฉพาะใน apps/hq/.env.local (gitignore) และ env ของ Vercel (server-side)
#   • ใช้เฉพาะในโค้ดฝั่งเซิร์ฟเวอร์ (route.ts) เท่านั้น
# เอาค่าจาก Supabase → Project Settings → API → service_role (secret)
# ยังไม่ใส่ = ปุ่ม "สร้างตัวแทน" จะขึ้น error ตามจริงว่ายังไม่ได้ตั้งค่า (ไม่แกล้งทำสำเร็จ)
SUPABASE_SERVICE_ROLE_KEY=

# ── การตั้งค่าฝั่ง Supabase ที่ต้องทำเพิ่ม (ไม่ใช่ env) ────────────────────────────
# H4 (รีเซ็ตรหัสผ่านทางอีเมล) ต้องตั้งที่ Supabase Dashboard:
#   1) Authentication → URL Configuration → Redirect URLs: เพิ่ม
#        http://localhost:3002/reset-password           (ตอน dev)
#        https://<โดเมน HQ ของคุณ>/reset-password        (ตอน production)
#   2) Authentication → Emails: ตั้งค่า SMTP ของตัวเอง (บริการเดโมของ Supabase จำกัดปริมาณ/โดเมน)
#      และปรับเทมเพลต "Reset Password" ให้ลิงก์ไปที่ {{ .RedirectTo }}

# ── Observability (แจ้งเตือน error รวมศูนย์) — ไม่บังคับ ────────────────────────────
# ตั้ง DSN = เปิดส่ง error สำคัญ (repo เขียนล้มเหลว/realtime หลุด) ไป Sentry อัตโนมัติ
#   ไม่ตั้ง = ทำงานปกติ (error ลง console เหมือนเดิม · captureError เป็น no-op sink)
# วิธีเปิด: (1) pnpm add @sentry/nextjs  (2) ใส่ DSN ด้านล่าง  (ดู packages/shared/lib/observability.ts)
NEXT_PUBLIC_SENTRY_DSN=
