{
  "name": "benjamin-pms",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev": "turbo dev",
    "dev:hq": "turbo dev --filter=hq",
    "dev:dealer": "turbo dev --filter=dealer",
    "build": "turbo build",
    "typecheck": "turbo typecheck && tsc -p tests/tsconfig.json --noEmit",
    "lint": "turbo lint",
    "test": "playwright test",
    "test:unit": "vitest run",
    "typecheck:tests": "tsc -p tests/tsconfig.json --noEmit",
    "preflight": "node scripts/preflight.mjs",
    "load-test": "node scripts/load-test.mjs",
    "checks": "node scripts/check-stable-order.mjs && node scripts/check-form-labels.mjs && node scripts/check-unchecked-mutations.mjs && node scripts/check-paginated-lookup.mjs && node scripts/check-network-list-keys.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@sentry/nextjs": "^10.68.0",
    "@supabase/supabase-js": "^2.110.7",
    "supabase": "^2.109.1",
    "turbo": "^2.3.0",
    "vitest": "^4.1.10"
  }
}
